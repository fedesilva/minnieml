{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "MinnieML",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#docComments"
        },
        {
            "include": "#declarationHeader"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#types"
        },
        {
            "include": "#identifiers"
        },
        {
            "include": "#native"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.mml",
                    "match": "//.*$"
                }
            ]
        },
        "docComments": {
            "name": "comment.block.documentation.mml",
            "begin": "(/\\*)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.comment.begin.mml"
                }
            },
            "end": "(\\*/)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.comment.end.mml"
                }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.mml",
                    "match": "\\b(if|then|elif|else)\\b"
                },
                {
                    "name": "keyword.other.mml",
                    "match": "\\b(module|fn|let|op|end|pub|protected|lexical|type|inline|protocol|instance)\\b"
                },
                {
                    "name": "keyword.operator.mml",
                    "match": "\\b(left|right)\\b"
                },
                {
                    "name": "constant.language.mml",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.mml",
                    "match": "\\(\\)"
                },
                {
                    "name": "constant.language.mml",
                    "match": "\\b(\\?\\?\\?|\\_)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.mml",
                    "match": "="
                },
                {
                    "name": "punctuation.terminator.mml",
                    "match": ";"
                },
                {
                    "name": "keyword.operator.type.mml",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.mml",
                    "match": "[=!#$%^&*+<>?/\\\\|~\\-]+"
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "name": "string.quoted.double.mml",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.mml",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "constant.numeric.integer.mml",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.float.mml",
                    "match": "\\b[0-9]*\\.[0-9]+\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.mml",
                    "match": "'[A-Z][a-zA-Z0-9]*|\\b[A-Z][a-zA-Z0-9]*\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.parameter.mml",
                    "match": "\\b[a-z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "native": {
            "patterns": [
                {
                    "name": "entity.name.tag.mml",
                    "match": "@metal:(repr|ffi|tpl)\\b"
                }
            ]
        },
        "declarationHeader": {
            "patterns": [
                {
                    "begin": "\\b(fn|op)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.mml"
                        }
                    },
                    "end": "(?==|;|\\b(?:let|fn|op|type|struct|protocol|instance|pub|prot|priv|inline)\\b)",
                    "patterns": [
                        {
                            "begin": "(?<=\\b(?:fn|op))\\G",
                            "end": "([A-Za-z][A-Za-z0-9_]*|(?!//|/\\*)[=!#$%^&*+<>?/\\\\|.~-]+)|(?=;)",
                            "endCaptures": {
                                "1": {
                                    "name": "entity.name.function.mml"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#comments"
                                },
                                {
                                    "include": "#docComments"
                                }
                            ]
                        },
                        {
                            "include": "#declarationHeaderBody"
                        }
                    ]
                },
                {
                    "begin": "\\b(protocol)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.other.mml"
                        }
                    },
                    "end": "(?==|;|\\b(?:let|fn|op|type|struct|protocol|instance|pub|prot|priv|inline)\\b)",
                    "patterns": [
                        {
                            "begin": "(?<=\\bprotocol)\\G",
                            "end": "\\b([A-Za-z][A-Za-z0-9_]*)\\b|(?==|;)",
                            "endCaptures": {
                                "1": {
                                    "name": "storage.type.mml"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#comments"
                                },
                                {
                                    "include": "#docComments"
                                }
                            ]
                        },
                        {
                            "include": "#declarationHeaderBody"
                        }
                    ]
                }
            ],
            "comment": "The declaration name can follow comments and newlines. Parameter regions protect ordinary where identifiers. Only the header body recognizes a constraint clause."
        },
        "declarationHeaderBody": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#docComments"
                },
                {
                    "include": "#headerParameters"
                },
                {
                    "name": "keyword.other.mml",
                    "match": "\\bwhere\\b"
                },
                {
                    "name": "keyword.operator.mml",
                    "match": "\\b(left|right)\\b"
                },
                {
                    "include": "#literals"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#identifiers"
                }
            ]
        },
        "headerParameters": {
            "begin": "\\(",
            "end": "\\)|(?==|;|\\b(?:let|fn|op|type|struct|protocol|instance|pub|prot|priv|inline)\\b)",
            "patterns": [
                {
                    "include": "#headerParameters"
                },
                {
                    "include": "#comments"
                },
                {
                    "include": "#docComments"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#identifiers"
                }
            ],
            "comment": "Matches nested parameter types. A body delimiter or declaration start also ends an incomplete header so later declarations retain their scopes."
        }
    },
    "scopeName": "source.mml"
}

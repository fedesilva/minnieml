// Names, native symbols, ownership markers, and templates match those injectors.
// The native void and named-struct pointer spellings below describe injected AST types;
// the source parser does not currently accept those two representation forms.

// Native types and aliases
type Int64 = @metal:repr[t=i64];
type Int32 = @metal:repr[t=i32];
type Int16 = @metal:repr[t=i16];
type Int8 = @metal:repr[t=i8];
type Float = @metal:repr[t=float];
type Double = @metal:repr[t=double];
type Bool = @metal:repr[t=i1];
type CharPtr = @metal:repr[t=*i8];
type RawPtr = @metal:repr[t=ptr];
type CString = @metal:repr[t=*i8, mem=heap, free=free_cstr];

type String = @metal:repr[mem=heap] {
  length: Int32,
  data: CharPtr
};

type SizeT = @metal:repr[t=i64];
type Char = @metal:repr[t=i8];
type Unit = @metal:repr[t=void];

type Int = Int32;
type Byte = Int8;
type Word = Int8;

type Buffer = @metal:repr[t=*i8, mem=heap];
type Rng = @metal:repr[t=*i8, mem=heap];

type Int64Ptr = @metal:repr[t=*i64];
type Int32Ptr = @metal:repr[t=*i32];
type StringPtr = @metal:repr[t=*%struct.String];
type FloatPtr = @metal:repr[t=*float];

type IntArray = @metal:repr[mem=heap] {
  length: Int32,
  data: Int32Ptr
};
type StringArray = @metal:repr[mem=heap] {
  length: Int32,
  data: StringPtr
};
type FloatArray = @metal:repr[mem=heap] {
  length: Int32,
  data: FloatPtr
};

// Numeric operations share one protocol; instance members inherit its types and metadata.
protocol Num 'T =
  op +(a: 'T, b: 'T): 'T 60 left;
  op -(a: 'T, b: 'T): 'T 60 left;
  op *(a: 'T, b: 'T): 'T 80 left;
  op /(a: 'T, b: 'T): 'T 80 left;
  op ==(a: 'T, b: 'T): Bool 50 left;
  op !=(a: 'T, b: 'T): Bool 50 left;
  op <(a: 'T, b: 'T): Bool 50 left;
  op >(a: 'T, b: 'T): Bool 50 left;
  op <=(a: 'T, b: 'T): Bool 50 left;
  op >=(a: 'T, b: 'T): Bool 50 left;
  op -(a: 'T): 'T 95 right;
;

instance Num Int =
  op +(a, b) = @metal:tpl["add %type %operand1, %operand2"];;
  op -(a, b) = @metal:tpl["sub %type %operand1, %operand2"];;
  op *(a, b) = @metal:tpl["mul %type %operand1, %operand2"];;
  op /(a, b) = @metal:tpl["sdiv %type %operand1, %operand2"];;
  op ==(a, b) = @metal:tpl["icmp eq %type %operand1, %operand2"];;
  op !=(a, b) = @metal:tpl["icmp ne %type %operand1, %operand2"];;
  op <(a, b) = @metal:tpl["icmp slt %type %operand1, %operand2"];;
  op >(a, b) = @metal:tpl["icmp sgt %type %operand1, %operand2"];;
  op <=(a, b) = @metal:tpl["icmp sle %type %operand1, %operand2"];;
  op >=(a, b) = @metal:tpl["icmp sge %type %operand1, %operand2"];;
  op -(a) = @metal:tpl["sub %type 0, %operand"];;
;

instance Num Float =
  op +(a, b) = @metal:tpl["fadd %type %operand1, %operand2"];;
  op -(a, b) = @metal:tpl["fsub %type %operand1, %operand2"];;
  op *(a, b) = @metal:tpl["fmul %type %operand1, %operand2"];;
  op /(a, b) = @metal:tpl["fdiv %type %operand1, %operand2"];;
  op ==(a, b) = @metal:tpl["fcmp oeq %type %operand1, %operand2"];;
  op !=(a, b) = @metal:tpl["fcmp une %type %operand1, %operand2"];;
  op <(a, b) = @metal:tpl["fcmp olt %type %operand1, %operand2"];;
  op >(a, b) = @metal:tpl["fcmp ogt %type %operand1, %operand2"];;
  op <=(a, b) = @metal:tpl["fcmp ole %type %operand1, %operand2"];;
  op >=(a, b) = @metal:tpl["fcmp oge %type %operand1, %operand2"];;
  op -(a) = @metal:tpl["fsub %type 0.0, %operand"];;
;

// Integer-only and Boolean operators remain free functions.
op %(a: Int, b: Int): Int 80 left = @metal:tpl["srem %type %operand1, %operand2"];;
op <<(a: Int, b: Int): Int 55 left = @metal:tpl["shl %type %operand1, %operand2"];;
op >>(a: Int, b: Int): Int 55 left = @metal:tpl["ashr %type %operand1, %operand2"];;
op +(a: Int): Int 95 right = @metal:tpl["add %type 0, %operand"];;
op and(a: Bool, b: Bool): Bool 40 left = @metal:tpl["and %type %operand1, %operand2"];;
op or(a: Bool, b: Bool): Bool 30 left = @metal:tpl["or %type %operand1, %operand2"];;
op not(a: Bool): Bool 95 right = @metal:tpl["xor %type 1, %operand"];;

// String conversion protocol
protocol ToString 'T =
  fn to_str(value: 'T): String;
;

instance ToString Int =
  fn to_str(value) = @metal:ffi[name="int_to_str", mem=alloc];;
;

instance ToString Float =
  fn to_str(value) = @metal:ffi[name="float_to_str", mem=alloc];;
;

instance ToString Int64 =
  fn to_str(value) = @metal:ffi[name="int64_to_str", mem=alloc];;
;

instance ToString Int8 =
  fn to_str(value) = @metal:ffi[name="int8_to_str", mem=alloc];;
;

instance ToString Int16 =
  fn to_str(value) = @metal:ffi[name="int16_to_str", mem=alloc];;
;

instance ToString Double =
  fn to_str(value) = @metal:ffi[name="double_to_str", mem=alloc];;
;

instance ToString Bool =
  fn to_str(value) = @metal:ffi[name="bool_to_str", mem=alloc];;
;

instance ToString Char =
  fn to_str(value) = @metal:ffi[name="char_to_str", mem=alloc];;
;

instance ToString SizeT =
  fn to_str(value) = @metal:ffi[name="sizet_to_str", mem=alloc];;
;

instance ToString Unit =
  fn to_str(value) = @metal:ffi[name="unit_to_str", mem=alloc];;
;

instance ToString String =
  fn to_str(value) = @metal:ffi[name="__clone_String", mem=alloc];;
;

instance ToString CString =
  fn to_str(value) = @metal:ffi[name="cstring_to_str", mem=alloc];;
;

// I/O and strings
fn mml_sys_flush(): Unit = @metal:ffi;;

fn readline(): String = @metal:ffi[mem=alloc];;

fn print(a: String): Unit = @metal:ffi;;
fn println(a: String): Unit = @metal:ffi;;

fn concat(a: String, b: String): String = @metal:ffi[mem=alloc];;
fn str_eq(a: String, b: String): Bool = @metal:ffi;;
fn str_strip_margin(a: String): String = @metal:ffi[mem=alloc];;
fn int_to_str(a: Int): String = @metal:ffi[mem=alloc];;
fn float_to_str(a: Float): String = @metal:ffi[mem=alloc];;
fn str_to_int(a: String): Int = @metal:ffi;;
fn to_cstr(s: String): CString = @metal:ffi[mem=alloc];;

op ++(a: String, b: String): String 61 right = concat a b;;

// Random number generation
fn rng_new(seed: Int): Rng = @metal:ffi[mem=alloc];;
fn rng_new_random(): Rng = @metal:ffi[mem=alloc];;
fn rng_next(rng: Rng): Int = @metal:ffi;;
fn rng_between(rng: Rng, min: Int, max: Int): Int = @metal:ffi;;

// Buffer constructors retain their current injected names.
fn mkBuffer(): Buffer = @metal:ffi[mem=alloc];;
fn mkBufferWithFd(fd: Int): Buffer = @metal:ffi[mem=alloc];;
fn mkBufferWithFdAndSize(fd: Int, size: Int): Buffer = @metal:ffi[mem=alloc];;
fn mkBufferWithSize(size: Int): Buffer = @metal:ffi[mem=alloc];;
fn flush(b: Buffer): Unit = @metal:ffi;;
fn buffer_write(b: Buffer, s: String): Unit = @metal:ffi;;
fn buffer_writeln(b: Buffer, s: String): Unit = @metal:ffi;;
fn buffer_write_byte(b: Buffer, n: Int): Unit = @metal:ffi;;
fn buffer_write_int(b: Buffer, n: Int): Unit = @metal:ffi;;
fn buffer_writeln_int(b: Buffer, n: Int): Unit = @metal:ffi;;

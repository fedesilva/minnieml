fn __free_IntArray(~a: IntArray): Unit = @metal:ffi;;
fn __free_StringArray(~a: StringArray): Unit = @metal:ffi;;
fn __free_FloatArray(~a: FloatArray): Unit = @metal:ffi;;

// Compiler-facing cloning helpers return newly allocated values.
fn __clone_String(s: String): String = @metal:ffi[mem=alloc];;
fn __clone_Buffer(b: Buffer): Buffer = @metal:ffi[mem=alloc];;
fn __clone_Rng(rng: Rng): Rng = @metal:ffi[mem=alloc];;

// C = A * B
// Matrices are N x N, flattened into 1D arrays of size N*N
// Access: index = row * N + col

fn fill_matrix(arr: IntArray, n: Int, seed: Int): Unit =
  let size = n * n;

  fn fill_matrix_loop(i: Int, current_seed: Int): Unit =
    if i < size then
      let next_seed = (current_seed * 25173 + 13849) % 65536;
      // Values in [-50, 49] keep the 500x500 products and trace within Int32.
      unsafe_ar_int_set arr i ((next_seed % 100) - 50);
      fill_matrix_loop (i + 1) next_seed;
    ;
  ;

  fill_matrix_loop 0 seed;
;

fn mat_mul(a: IntArray, b: IntArray, c: IntArray, n: Int): Unit =
  // Outer loop: i from 0 to n
  fn mat_mul_i(i: Int): Unit =
    // Middle loop: j from 0 to n
    fn mat_mul_j(j: Int): Unit =
      // Inner loop: sum(A[i][k] * B[k][j]) for k from 0 to n
      fn mat_mul_k(k: Int, acc: Int): Int =
        if k < n then
          // A[i][k]: sequential access
          let idx_a = (i * n) + k;
          // B[k][j]: strided access
          let idx_b = (k * n) + j;

          let val_a = unsafe_ar_int_get a idx_a;
          let val_b = unsafe_ar_int_get b idx_b;

          mat_mul_k (k + 1) (acc + (val_a * val_b));
        else
          acc;
        ;
      ;

      if j < n then
        let val = mat_mul_k 0 0;
        let idx_c = (i * n) + j;
        unsafe_ar_int_set c idx_c val;
        mat_mul_j (j + 1);
      ;
    ;

    if i < n then
      mat_mul_j 0;
      mat_mul_i (i + 1);
    ;
  ;

  mat_mul_i 0;
;

// Verify result (Trace)
fn trace(arr: IntArray, n: Int): Int =
  fn trace_loop(i: Int, acc: Int): Int =
    if i < n then
      let idx = (i * n) + i;
      let val = unsafe_ar_int_get arr idx;
      trace_loop (i + 1) (acc + val);
    else
      acc;
    ;
  ;

  trace_loop 0 0;
;

pub fn main(): Unit =
  // 500x500 matrix = 250,000 elements.
  let n = 500;
  let a = ar_int_new (n * n);
  let b = ar_int_new (n * n);
  let c = ar_int_new (n * n);

  fill_matrix a n 42;
  fill_matrix b n 1337;

  mat_mul a b c n;

  let result = trace c n;
  println ("Trace Checksum: " ++ (int_to_str result));
;

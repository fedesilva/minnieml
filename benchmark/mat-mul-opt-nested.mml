// C = A * B
// Optimized Version: Loop Interchange (i-k-j) for Sequential Access
// Matrices are N x N, flattened into 1D arrays of size N*N

// --- Initialization ---

fn fill_matrix(arr: IntArray, n: Int, seed: Int): Unit =
  let size = n * n;

  fn fill_matrix_loop(i: Int, current_seed: Int): Unit =
    if i < size then
      let next_seed = (current_seed * 1664525) + 1013904223;
      // Keep numbers small to avoid immediate overflow during multiplication.
      unsafe_ar_int_set arr i (next_seed % 100);
      fill_matrix_loop (i + 1) next_seed;
    ;
  ;

  fill_matrix_loop 0 seed;
;

// --- Matrix Multiplication (Interchanged) ---

fn mat_mul(a: IntArray, b: IntArray, c: IntArray, n: Int): Unit =
  let size = n * n;

  fn zero_matrix_loop(i: Int): Unit =
    if i < size then
      unsafe_ar_int_set c i 0;
      zero_matrix_loop (i + 1);
    ;
  ;

  fn mat_mul_i(i: Int): Unit =
    fn mat_mul_k(k: Int): Unit =
      if k < n then
        // Load A[i][k] once for the whole inner row.
        let idx_a = (i * n) + k;
        let val_a = unsafe_ar_int_get a idx_a;

        // C[i][j] += A[i][k] * B[k][j], with sequential access to B and C.
        fn mat_mul_j(j: Int): Unit =
          if j < n then
            let idx_c = (i * n) + j;
            let idx_b = (k * n) + j;
            let val_b = unsafe_ar_int_get b idx_b;
            let old_c = unsafe_ar_int_get c idx_c;

            unsafe_ar_int_set c idx_c (old_c + val_a * val_b);
            mat_mul_j (j + 1);
          ;
        ;

        mat_mul_j 0;
        mat_mul_k (k + 1);
      ;
    ;

    if i < n then
      mat_mul_k 0;
      mat_mul_i (i + 1);
    ;
  ;

  zero_matrix_loop 0;
  mat_mul_i 0;
;

// --- Verification ---

fn trace(arr: IntArray, n: Int): Int =
  fn trace_loop(i: Int, acc: Int): Int =
    if i < n then
      let idx = (i * n) + i;
      let val = unsafe_ar_int_get arr idx;
      trace_loop (i + 1) (acc + val);
    else
      acc;
    ;
  ;

  trace_loop 0 0;
;

// --- Main ---

pub fn main(): Unit =
  let n = 500;
  let a = ar_int_new (n * n);
  let b = ar_int_new (n * n);
  let c = ar_int_new (n * n);

  fill_matrix a n 42;
  fill_matrix b n 1337;

  mat_mul a b c n;

  let result = trace c n;
  println ("Trace Checksum: " ++ (int_to_str result));
;

// Protocol prerequisites: requirements may form chains and share dependencies.
// Run with: mmlc run mml/samples/protocol-constraints.mml

// Describe and Display both require ToString, so Render requires it transitively.
// An explicit & ToString is also allowed, but each protocol may be written only once.
// Every Render instance requires these instances for the same concrete type.
protocol Render 'T where
    'T: Describe & Display =
  fn render(label: String, value: 'T): String;
;

// Int implements each protocol. The declarations may follow their uses.
instance Render Int =
  fn render(label, value) =
    label ++ (describe value) ++ " " ++ (display value);
  ;
;

protocol Describe 'T where 'T: ToString =
  fn describe(value: 'T): String;
;

protocol Display 'T where 'T: ToString =
  fn display(value: 'T): String;
;

instance Display Int =
  fn display(value) = "[" ++ (to_str value) ++ "]";;
;

instance Describe Int =
  fn describe(value) = "number " ++ (to_str value);;
;

// Render supplies Describe, Display, and ToString to generic bodies.
fn render_value(value: 'T): String
  where 'T: Render =
    render "generic: " value;
;

fn describe_value(value: 'T): String
  where 'T: Render =
    let as_text: 'T -> String = to_str;
    (describe value) ++ " " ++ (display value) ++ " (" ++ (as_text value) ++ ")";
;

fn decorate(label: String, value: 'T): String
  where 'T: ToString =
    label ++ (to_str value);
;

// Forward to a weaker constraint, retaining the partially applied function.
fn forward(value: 'T): String
  where 'T: Render =
    let formatted: 'T -> String = decorate "forwarded: ";
    formatted value;
;

// Local functions share evidence for the enclosing type variable.
fn nested(value: 'T): String
  where 'T: Render =
    fn local(other: 'T): String = to_str other;;
    local value;
;

pub fn main(): Unit =
  println (render "direct: " 42);

  let render_int = render;
  println (render_int "function value: " 7);

  let render_again = render "partial: ";
  println (render_again 9);

  println (render_value 11);
  println ("implied: " ++ (describe_value 13));
  println (forward 17);
  println ("nested: " ++ (nested 19));
;

// Expected output:
// direct: number 42 [42]
// function value: number 7 [7]
// partial: number 9 [9]
// generic: number 11 [11]
// implied: number 13 [13] (13)
// forwarded: 17
// nested: 19


// Run: mmlc run mml/samples/link-zlib.mml
// Requires zlib's linker library (provided by the macOS SDK; zlib1g-dev on Debian/Ubuntu).
@link["z"];

// zlib returns an unsigned long; Int64 has the same width on 64-bit macOS and Linux.
fn zlibCompileFlags(): Int64 = @metal:ffi;;

pub fn main(): Unit =
  println ("zlib compile flags: " ++ to_str (zlibCompileFlags ()));
;

// Build and emit optimized IR: mmlc -x lib -O3 -I mml/samples/native-aggregates.mml
// See native-aggregates.c for the C implementations and build commands.

pub fn main(): Unit =

  let point = shift_point (Vec2 1.5 (0.0 - 2.5));
  println ("Vec2: " ++ (to_str point.x) ++ ", " ++ (to_str point.y));

  let rect = grow_rect (Rect 3.0 4.0 5.0 6.0);
  println (
    "Rect: " ++ (to_str rect.x) ++ ", " ++ (to_str rect.y)
      ++ ", " ++ (to_str rect.width) ++ ", " ++ (to_str rect.height)
  );

  let wide = rotate_wide (Wide (int_to_int64 11) (int_to_int64 22) (int_to_int64 33));
  println (
    "Wide: " ++ (to_str wide.a) ++ ", " ++ (to_str wide.b)
      ++ ", " ++ (to_str wide.c)
  );
;

type Vec2 = @metal:repr { x: Float, y: Float };
type Rect = @metal:repr { x: Float, y: Float, width: Float, height: Float };
type Wide = @metal:repr { a: Int64, b: Int64, c: Int64 };

fn shift_point(point: Vec2): Vec2 = @metal:ffi;;
fn grow_rect(rect: Rect): Rect = @metal:ffi;;
fn rotate_wide(wide: Wide): Wide = @metal:ffi;;

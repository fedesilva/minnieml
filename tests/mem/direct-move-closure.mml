// Direct move-capturing closure regression.
//
// A let-bound move-capturing lambda used only in saturated calls is Direct, so
// codegen emits a direct entry with captured values as trailing operands and no
// closure env allocation.
pub fn main(): Unit =
  let a = 1;
  let f = ~{ x: Int -> x + a; };
  let r = f 41;
  println (int_to_str r);
;

// Closure creation, invocation, and drop cover every ownership and operation choice.
struct Box { text: String };

fn check(ok: Bool): Int = if ok then 0; else 1; ;;
fn take(~text: String): Int = text.length;;
fn staged(~text: String, extra: Int): Int = text.length + extra;;
fn borrow(text: String, extra: Int): Int = text.length + extra;;
fn inc(n: Int): Int = n + 1;;

fn repeated(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let alias = value;
  let f = ~{ n: Int -> alias.length + n; };
  check (f 1 + f 2 == 9);
;

fn local_function(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  fn ~measure(n: Int): Int = value.length + n;;
  check (measure 1 + measure 2 == 9);
;

fn borrowed_closures(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let first = { n: Int -> value.length + n; };
  fn second(n: Int): Int = value.length + n;;
  let p = borrow value;
  check (first 1 + second 2 + p 3 + p 4 + value.length == 25);
;

fn invocation_or_drop(flag: Bool, invoked: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let f = ~{ n: Int -> take value + n; };
  if invoked then check (f 2 == 5); else 0;;
;

fn capture_or_retain(flag: Bool, captured: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  if captured then
    let f = ~{ n: Int -> value.length + n; };
    check (f 2 == 5);
  else
    check (value.length == 3);
  ;
;

fn multiple_captures(first_owned: Bool, second_owned: Bool): Int =
  let first = if first_owned then to_str 123; else "abc";;
  let second = if second_owned then to_str 4567; else "defg";;
  let f = ~{ n: Int -> take first + second.length + n; };
  check (f 1 == 8);
;

fn make_reader(flag: Bool): Int -> Int =
  let value = (
    let inner = if flag then to_str 123; else "abc";;
    let alias = inner;
    alias
  );
  ~{ n: Int -> value.length + n; };
;

fn returned_closure(flag: Bool): Int =
  let f = make_reader flag;
  check (f 1 + f 2 == 9);
;

fn nested(flag: Bool, invoked: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let outer = ~{ unit: Unit ->
    ~{ n: Int -> value.length + n; };
  };
  if invoked then
    let inner = outer ();
    check (inner 1 + inner 2 == 9);
  else
    0;
  ;
;

fn nested_inner_drop(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let outer = ~{ unit: Unit -> ~{ n: Int -> value.length + n; }; };
  let inner = outer ();
  0;
;

fn captured_field(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let f = ~{ n: Int ->
    let box = Box value;
    box.text.length + n;
  };
  check (f 1 == 4);
;

fn captured_return(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let f = ~{ unit: Unit -> value; };
  let result = f ();
  let expected = if flag then "123"; else "abc";;
  check (str_eq result expected);
;

fn return_text(flag: Bool): String =
  let value = if flag then to_str 123; else "abc";;
  let alias = value;
  alias;
;

fn returned_payload_pap(flag: Bool, invoked: Bool): Int =
  let p = staged (return_text flag);
  if invoked then check (p 1 == 4); else 0;;
;

fn captured_payload_pap(flag: Bool, invoked: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let outer = ~{ unit: Unit -> staged value; };
  let p = outer ();
  if invoked then check (p 1 == 4); else 0;;
;

fn conditional_capture(flag: Bool, first_selected: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  let other = to_str 4567;
  let f =
    if first_selected then
      ~{ n: Int -> value.length + n; };
    else
      ~{ n: Int -> other.length + n; };
    ;
  let expected = if first_selected then 4; else 5;;
  check (f 1 == expected);
;

fn resource_free_alternative(flag: Bool): Int -> Int =
  let value = if flag then to_str 123; else "abc";;
  if flag then ~{ n: Int -> value.length + n; }; else inc;;
;

fn callable_alternatives(flag: Bool): Int =
  let f = resource_free_alternative flag;
  let expected = if flag then 4; else 2;;
  check (f 1 == expected);
;

fn shadowed_capture(flag: Bool, scoped: Bool): Int =
  let value = to_str 4567;
  let f =
    if scoped then
      let value = if flag then to_str 123; else "abc";;
      ~{ n: Int -> value.length + n; };
    else
      make_reader flag;
    ;
  check (value.length + f 1 == 8);
;

fn decide(trace: IntArray, flag: Bool): Bool =
  ar_int_set trace 0 (ar_int_get trace 0 + 1);
  flag;
;

fn allocate(trace: IntArray): String =
  ar_int_set trace 1 (ar_int_get trace 1 + 1);
  to_str 123;
;

fn capture_effects(flag: Bool): Int =
  let trace = ar_int_new 2;
  ar_int_fill trace 0;
  let value = if decide trace flag then allocate trace; else "abc";;
  let f = ~{ n: Int -> value.length + n; };
  let result = f 1 + f 2;
  let allocations = if flag then 1; else 0;;
  check (result == 9 and ar_int_get trace 0 == 1 and ar_int_get trace 1 == allocations);
;

fn recursive_capture(flag: Bool): Int =
  let value = if flag then to_str 123; else "abc";;
  fn ~walk(remaining: Int, total: Int): Int =
    if remaining == 0 then
      total;
    else
      walk (remaining - 1) (total + value.length);
    ;
  ;
  check (walk 10000 0 == 30000);
;

fn scenario(allocated: Bool, invoked: Bool): Int =
  let a = repeated allocated;
  let b = local_function allocated;
  let c = borrowed_closures allocated;
  let d = invocation_or_drop allocated invoked;
  let e = capture_or_retain allocated invoked;
  let f = multiple_captures allocated invoked;
  let g = returned_closure allocated;
  let h = nested allocated invoked;
  let i = nested_inner_drop allocated;
  let j = captured_field allocated;
  let k = captured_return allocated;
  let l = returned_payload_pap allocated invoked;
  let m = captured_payload_pap allocated invoked;
  let n = conditional_capture allocated invoked;
  let o = callable_alternatives allocated;
  let p = shadowed_capture allocated invoked;
  let q = capture_effects allocated;
  let r = recursive_capture allocated;
  a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r;
;

fn run(remaining: Int, seed: Int, failures: Int): Int =
  if remaining == 0 then
    failures;
  else
    let result = scenario (seed % 2 == 0) (seed % 4 < 2);
    run (remaining - 1) (seed + 1) (failures + result);
  ;
;

pub fn main(args: StringArray): Int = run 4 (ar_str_len args) 0;;

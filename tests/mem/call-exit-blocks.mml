// Conditional operands retain their final blocks through calls, operators, and loops.
struct Ops { call: Int -> Int };

fn identity(value: Int): Int = value;;
fn combine(left: Int, right: Int): Int = left + right;;
fn keep(effect: Unit, value: Int): Int = value;;

fn mark(trace: IntArray, digit: Int, value: Int): Int =
  ar_int_set trace 0 (ar_int_get trace 0 * 10 + digit);
  value;
;

fn effect(trace: IntArray, digit: Int): Unit =
  ar_int_set trace 0 (ar_int_get trace 0 * 10 + digit);
;

fn direct(enabled: Bool, flag: Bool, trace: IntArray): Int =
  if enabled then
    combine (if flag then mark trace 1 10; else mark trace 2 20;) (mark trace 3 7);
  else 3;
  ;
;

fn local(enabled: Bool, flag: Bool, trace: IntArray): Int =
  fn sum(left: Int, right: Int): Int = left + right;;
  if enabled then
    sum (if flag then mark trace 1 10; else mark trace 2 20;) (mark trace 3 7);
  else 3;
  ;
;

fn known(enabled: Bool, flag: Bool, trace: IntArray): Int =
  let seed = 7;
  fn add(value: Int): Int = value + seed;;
  if enabled then add (if flag then mark trace 1 10; else mark trace 2 20;);
  else 3;
  ;
;

fn indirect(f: Int -> Int, enabled: Bool, flag: Bool, trace: IntArray): Int =
  if enabled then f (if flag then mark trace 1 10; else mark trace 2 20;);
  else 3;
  ;
;

fn qualified(box: Ops, enabled: Bool, flag: Bool, trace: IntArray): Int =
  if enabled then
    (if flag then box; else box;).call (mark trace 1 7);
  else 3;
  ;
;

fn unit_arg(enabled: Bool, flag: Bool, trace: IntArray): Int =
  if enabled then
    keep (if flag then effect trace 1; else effect trace 2;) (mark trace 3 7);
  else 3;
  ;
;

fn known_qualified(enabled: Bool, flag: Bool, trace: IntArray): Int =
  let seed = 7;
  fn ~add(value: Int): Int = value + seed;;
  let box = Ops add;
  if enabled then
    (if flag then box; else box;).call (if flag then mark trace 1 10; else mark trace 2 20;);
  else 3;
  ;
;

fn operator(enabled: Bool, flag: Bool, trace: IntArray): Int =
  if enabled then (if flag then mark trace 1 10; else mark trace 2 20;) + (mark trace 3 7);
  else 3;
  ;
;

fn check(value: Int, expected: Int, trace: IntArray, expected_trace: Int): Int =
  let valid = value == expected and ar_int_get trace 0 == expected_trace;
  ar_int_set trace 0 0;
  if valid then 0; else 1;
  ;
;

fn fill(values: IntArray, count: Int, flag: Bool): Unit =
  fn loop(i: Int): Unit =
    if i < count then
      let selected = if flag then i % 2 == 0; else i % 2 != 0;;
      ar_int_set values i (if selected then 1; else 0;);
      loop (i + 1);
    ;
  ;
  loop 0;
;

pub fn main(args: StringArray): Int =
  let count = ar_str_len args;
  let enabled = count < 2;
  let flag = count == 0;
  let trace = ar_int_new 1;
  ar_int_fill trace 0;
  let pair = if flag then 13; else 23;;
  let selected = if flag then 1; else 2;;
  let base = if flag then 10; else 20;;
  let result = if enabled then base + 7; else 3;;
  let single = if enabled then base; else 3;;
  let seven = if enabled then 7; else 3;;
  let pair_trace = if enabled then pair; else 0;;
  let single_trace = if enabled then selected; else 0;;
  let callee_trace = if enabled then 1; else 0;;
  let a = check (direct enabled flag trace) result trace pair_trace;
  let b = check (local enabled flag trace) result trace pair_trace;
  let c = check (known enabled flag trace) result trace single_trace;
  let d = check (indirect identity enabled flag trace) single trace single_trace;
  let e = check (qualified (Ops identity) enabled flag trace) seven trace callee_trace;
  let f = check (unit_arg enabled flag trace) seven trace pair_trace;
  let g = check (operator enabled flag trace) result trace pair_trace;
  let h = check (known_qualified enabled flag trace) result trace single_trace;
  let values = ar_int_new 10000;
  fill values 10000 flag;
  let first = if flag then 1; else 0;;
  let last = if flag then 0; else 1;;
  let loop_ok = ar_int_get values 0 == first and ar_int_get values 9999 == last;
  if a + b + c + d + e + f + g + h == 0 and loop_ok then 0;
  else 1;
  ;
;

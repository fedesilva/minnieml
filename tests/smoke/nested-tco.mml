// Three nested tail-recursive functions, each with its own accumulator.
// The inner helper captures i and j from enclosing calls and borrows data from the caller.
// Their tail calls become loops while each new closure sees the current indices.
fn compute(data: IntArray, n: Int): Int =
  fn outer(i: Int, total: Int): Int =
    fn middle(j: Int, subtotal: Int): Int =
      fn inner(k: Int, acc: Int): Int =
        if k < 3 then
          let value = unsafe_ar_int_get data 0;
          inner (k + 1) (acc + i * 100 + j * 10 + k + value);
        else
          acc;
        ;
      ;

      if j < 3 then
        middle (j + 1) (subtotal + inner 0 0);
      else
        subtotal;
      ;
    ;

    if i < n then
      outer (i + 1) (total + middle 0 0);
    else
      total;
    ;
  ;

  outer 0 0;
;

pub fn main(): Int =
  let data = ar_int_new 1;
  unsafe_ar_int_set data 0 7;
  let result = compute data 4;
  println ("Nested checksum: " ++ int_to_str result);
  if result == 6048 then 0;
  else 1;
  ;
;
